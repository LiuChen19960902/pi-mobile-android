<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 内网构建允许连接开发机/LAN 的 ws:// Gateway。 -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <!-- P1 组件陈列宿主，仅 debug 变体；无 intent-filter 不进启动器。
             exported=true 是有意保留：API34 上 shell 无法启动 non-exported 组件，
             adb am start 是本宿主的主要入口；无 filter 时 launcher 不可见，暴露面可接受。
             adb: am start -n com.finecat.pimobile.android.preview/com.finecat.pimobile.android.ui.finecat.FineCatGalleryActivity -->
        <activity
            android:name="com.finecat.pimobile.android.ui.finecat.FineCatGalleryActivity"
            android:exported="true"
            android:label="FineCat Gallery"
            android:windowSoftInputMode="adjustResize" />

        <!-- F12 条件 6 的生产窗口配置等效宿主（仅 debug 变体）。
             逐条对齐 MainActivity：adjustResize + onCreate 里 enableEdgeToEdge()。
             没有 adjustResize 就拿不到 IME insets，键盘展开时窗口不 resize，
             「末行是否被键盘盖住」在这类宿主上根本不可验。 -->
        <activity
            android:name="com.finecat.pimobile.android.ui.finecat.FineCatCompatHostActivity"
            android:exported="false"
            android:label="F12 compat host"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.finecat.pimobile.android.ui.finecat.FineCatEvidenceHostActivity"
            android:exported="false"
            android:label="F14 evidence host"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
